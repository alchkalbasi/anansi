PRIVATE_NETWORK={{ docker_networks[0] }}
GARAGE_IMAGE_TAG={{ garage_image_tag }}
GARAGE_CONTAINER_NAME={{ garage_container_name }}
GARAGE_RESTART_POLICY={{ garage_restart_policy }}
GARAGE_BIND_HOST={{ garage_bind_host }}
GARAGE_S3_API_PORT={{ garage_s3_api_port }}
GARAGE_S3_WEB_PORT={{ garage_s3_web_port }}
GARAGE_ADMIN_PORT={{ garage_admin_port }}

COMPOSE_PROFILES={{ 'webui' if garage_webui_enabled else '' }}
GARAGE_S3_REGION={{ garage_s3_region }}
GARAGE_WEBUI_IMAGE_TAG={{ garage_webui_image_tag }}
GARAGE_WEBUI_CONTAINER_NAME={{ garage_webui_container_name }}
GARAGE_WEBUI_BIND_HOST={{ garage_webui_bind_host }}
GARAGE_WEBUI_PORT={{ garage_webui_port }}
# single quotes: keep the bcrypt "$" characters literal
GARAGE_WEBUI_AUTH_USER_PASS='{{ garage_webui_auth_user_pass }}'
GARAGE_WEBUI_ADMIN_KEY='{{ _garage_admin_token | default('') }}'
