# {{ ansible_managed }}
PRIVATE_NETWORK={{ docker_networks[0] }}
PUBLIC_NETWORK={{ docker_networks[1] }}
VAULTWARDEN_RESTART_POLICY={{ vaultwarden_restart_policy }}

VAULTWARDEN_IMAGE_TAG={{ vaultwarden_image_tag }}
VAULTWARDEN_CONTAINER_NAME={{ vaultwarden_container_name }}
VAULTWARDEN_BIND_HOST={{ vaultwarden_bind_host }}
VAULTWARDEN_HTTP_PORT={{ vaultwarden_http_port }}
VAULTWARDEN_HOSTNAME={{ vaultwarden_hostname }}

VAULTWARDEN_TRAEFIK_ENABLED={{ vaultwarden_traefik_enabled | bool | lower }}
VAULTWARDEN_TRAEFIK_ENTRYPOINT={{ vaultwarden_traefik_entrypoint }}
VAULTWARDEN_TRAEFIK_CERTRESOLVER={{ vaultwarden_traefik_certresolver }}
VAULTWARDEN_ADMIN_ALLOWED_IPS={{ vaultwarden_admin_allowed_ips }}

POSTGRES_IMAGE_TAG={{ vaultwarden_postgres_image_tag }}
POSTGRES_CONTAINER_NAME={{ vaultwarden_postgres_container_name }}
POSTGRES_DB={{ vaultwarden_postgres_db }}
POSTGRES_USER={{ vaultwarden_postgres_user }}
POSTGRES_PASSWORD='{{ _vaultwarden_secrets.postgres_password }}'
