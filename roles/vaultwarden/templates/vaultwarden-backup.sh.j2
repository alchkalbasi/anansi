#!/usr/bin/env bash
# {{ ansible_managed }}
# Dumps the Vaultwarden database and archives the data dir (RSA keys, attachments, sends).
set -euo pipefail
umask 077

LOCK_DIR="/run/vaultwarden-backup.lock"
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  echo "Vaultwarden backup is already running"
  exit 0
fi
trap 'rmdir "$LOCK_DIR"' EXIT

BACKUP_DIR="{{ vaultwarden_backup_dir }}"
SERVICE_DIR="{{ service_dir }}"
RETENTION_DAYS="{{ vaultwarden_backup_retention_days }}"
STAMP="$(date +%Y%m%d-%H%M%S)"
TARGET="$BACKUP_DIR/$STAMP"

mkdir -p "$TARGET"

echo "[$(date -Is)] dumping database"
docker exec "{{ vaultwarden_postgres_container_name }}" \
  pg_dump -U "{{ vaultwarden_postgres_user }}" -d "{{ vaultwarden_postgres_db }}" --clean --if-exists \
  | gzip > "$TARGET/db.sql.gz.part"
mv "$TARGET/db.sql.gz.part" "$TARGET/db.sql.gz"

echo "[$(date -Is)] archiving data dir"
tar -C "$SERVICE_DIR" --exclude='data/icon_cache' -czf "$TARGET/data.tar.gz" data

echo "[$(date -Is)] pruning backups older than $RETENTION_DAYS days"
find "$BACKUP_DIR" -mindepth 1 -maxdepth 1 -type d -mtime +"$RETENTION_DAYS" -exec rm -rf {} +

echo "[$(date -Is)] done: $TARGET"
