# {{ ansible_managed }}
# Loaded by compose through env_file. Values are single-quoted so "$" stays literal.
# Note: settings saved in the /admin panel go to data/config.json and override these.

DOMAIN={{ vaultwarden_domain }}
DATABASE_URL='postgresql://{{ vaultwarden_postgres_user }}:{{ _vaultwarden_secrets.postgres_password }}@{{ vaultwarden_postgres_container_name }}:5432/{{ vaultwarden_postgres_db }}'
LOG_LEVEL={{ vaultwarden_log_level }}
IP_HEADER={{ vaultwarden_ip_header }}
ENABLE_WEBSOCKET=true

# admin panel
{% if vaultwarden_admin_enabled %}
ADMIN_TOKEN='{{ _vaultwarden_secrets.admin_token }}'
{% else %}
# disabled (no ADMIN_TOKEN)
{% endif %}

# accounts and invitations
SIGNUPS_ALLOWED={{ vaultwarden_signups_allowed | bool | lower }}
SIGNUPS_VERIFY={{ vaultwarden_signups_verify | bool | lower }}
{% if vaultwarden_signups_domains_whitelist | length > 0 %}
SIGNUPS_DOMAINS_WHITELIST={{ vaultwarden_signups_domains_whitelist | join(',') }}
{% endif %}
INVITATIONS_ALLOWED={{ vaultwarden_invitations_allowed | bool | lower }}
INVITATION_ORG_NAME='{{ vaultwarden_invitation_org_name }}'
INVITATION_EXPIRATION_HOURS={{ vaultwarden_invitation_expiration_hours }}
{% if vaultwarden_org_creation_users | length > 0 %}
ORG_CREATION_USERS={{ vaultwarden_org_creation_users | join(',') }}
{% endif %}
EMERGENCY_ACCESS_ALLOWED={{ vaultwarden_emergency_access_allowed | bool | lower }}
SENDS_ALLOWED={{ vaultwarden_sends_allowed | bool | lower }}
PASSWORD_HINTS_ALLOWED={{ vaultwarden_password_hints_allowed | bool | lower }}
SHOW_PASSWORD_HINT=false

# RBAC / PBAC
ORG_GROUPS_ENABLED={{ vaultwarden_org_groups_enabled | bool | lower }}
EXPERIMENTAL_CUSTOM_ROLES={{ vaultwarden_experimental_custom_roles | bool | lower }}
ORG_EVENTS_ENABLED={{ vaultwarden_org_events_enabled | bool | lower }}
{% if vaultwarden_events_days_retain | string | length > 0 %}
EVENTS_DAYS_RETAIN={{ vaultwarden_events_days_retain }}
{% endif %}
ENFORCE_SINGLE_ORG_WITH_RESET_PW_POLICY={{ vaultwarden_enforce_single_org_with_reset_pw_policy | bool | lower }}

# smtp
{% if vaultwarden_smtp_host | length > 0 %}
SMTP_HOST={{ vaultwarden_smtp_host }}
SMTP_FROM={{ vaultwarden_smtp_from }}
SMTP_FROM_NAME='{{ vaultwarden_smtp_from_name }}'
SMTP_PORT={{ vaultwarden_smtp_port }}
SMTP_SECURITY={{ vaultwarden_smtp_security }}
{% if vaultwarden_smtp_username | length > 0 %}
SMTP_USERNAME={{ vaultwarden_smtp_username }}
SMTP_PASSWORD='{{ vaultwarden_smtp_password }}'
{% endif %}
{% else %}
# not configured
{% endif %}

# sso
SSO_ENABLED={{ vaultwarden_sso_enabled | bool | lower }}
{% if vaultwarden_sso_enabled %}
SSO_ONLY={{ vaultwarden_sso_only | bool | lower }}
SSO_AUTHORITY={{ vaultwarden_sso_authority }}
SSO_CLIENT_ID={{ vaultwarden_sso_client_id }}
SSO_CLIENT_SECRET='{{ vaultwarden_sso_client_secret }}'
SSO_SCOPES='{{ vaultwarden_sso_scopes }}'
SSO_SIGNUPS_MATCH_EMAIL={{ vaultwarden_sso_signups_match_email | bool | lower }}
{% endif %}

# push notifications
PUSH_ENABLED={{ vaultwarden_push_enabled | bool | lower }}
{% if vaultwarden_push_enabled %}
PUSH_INSTALLATION_ID={{ vaultwarden_push_installation_id }}
PUSH_INSTALLATION_KEY='{{ vaultwarden_push_installation_key }}'
PUSH_RELAY_URI={{ vaultwarden_push_uris[vaultwarden_push_region].relay }}
PUSH_IDENTITY_URI={{ vaultwarden_push_uris[vaultwarden_push_region].identity }}
{% endif %}
{% if vaultwarden_extra_env | length > 0 %}

# extra
{% for key, value in vaultwarden_extra_env.items() %}
{{ key }}='{{ value }}'
{% endfor %}
{% endif %}
